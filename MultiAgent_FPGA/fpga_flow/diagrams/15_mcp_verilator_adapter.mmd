flowchart LR
    subgraph Agent["LLM Agent"]
        W["Module Worker\nL2 Campaign Agent"]
    end

    subgraph Proxy["执行代理层"]
        RE["run_executor\n— 唯一合法入口 —\n加载合约 → 推断类型 → 分发"]
    end

    subgraph Executors["四层验证执行器"]
        direction TB
        L0["⚡ L0\n编译门控"]
        L1["🔍 L1\n仿真+Checkpoint"]
        L2["🎲 L2\n鲁棒性测试"]
        INT["🔗 Integration\n集成回归"]
    end

    subgraph Adapter["VerilatorMCPAdapter"]
        direction TB
        PRE["预处理\n文件过滤 | 自动 -I 标志\nC++17 | plusargs"]
        API["compile() / simulate()\n异步 MCP 调用"]
        PRE --> API
    end

    subgraph MCP["MCP Server (Node.js)"]
        direction TB
        STDIO["stdio 管道通信"]
        WL["工具白名单\n✅ verilator_compile\n✅ verilator_simulate\n🚫 testbenchgenerator\n🚫 naturallanguage"]
        STDIO --- WL
    end

    subgraph Verilator["Verilator"]
        direction TB
        VC["编译\nverilator --cc"]
        VS["仿真\nsimulation.log"]
        VC --> VS
    end

    subgraph Parse["Checkpoint 解析"]
        CP["CHECKPOINT|name|PASS|detail\n→ CheckpointParser\n→ passed / failed / missing"]
    end

    W -->|"调用"| RE
    RE --> L0 & L1 & L2 & INT
    L0 & L1 & L2 & INT --> PRE
    API -->|"call_tool"| STDIO
    STDIO --> VC
    VS --> CP
    CP -->|"RunExecutorObservation\nnext_read_hints"| W

